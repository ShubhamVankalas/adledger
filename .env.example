# AdLedger configuration. Every setting is optional — the defaults work out of the box.
# Copy to `.env` and edit. Connector credentials (Meta, Google Ads, Stripe) and the AI model
# are configured in the dashboard (Settings) and stored encrypted, so they are not listed here
# (the optional OAuth apps for one-click connect are the exception, see below).

# --- Core --------------------------------------------------------------------
# Public URL of this install (used in snippets and webhook URLs). Auto-detected if empty.
PUBLIC_URL=
# Port on your machine (docker compose).
PORT=3000
# Key that encrypts stored credentials and 2FA secrets. Generate with: openssl rand -base64 32
# If empty, one is generated on first boot and stored in the database (next to the data it
# protects). To move an existing install to APP_SECRET without losing saved credentials, copy the
# generated value: see docs/SECURITY.md → Encryption key.
APP_SECRET=
# Postgres password for the bundled database (docker compose).
POSTGRES_PASSWORD=adledger
# Use an external Postgres instead (e.g. Neon, Supabase, RDS). Leave empty for the bundled one.
# With `pnpm dev` and no DATABASE_URL, an embedded database is used (stored in ./.data).
# DATABASE_URL=postgres://user:pass@host:5432/adledger
# Where the embedded database and other files live when DATABASE_URL is empty.
# DATA_DIR=.data

# --- Headless setup (optional) ----------------------------------------------
# If set, the admin account is created on first boot (skip the setup screen).
# The values below are example test credentials for local development only.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ORGANIZATION_NAME=My business
# WORKSPACE_NAME=My business
# REPORTING_CURRENCY=USD
# TIMEZONE=UTC
# Load 90 days of demo data on first boot.
DEMO_DATA=
# Local dev test account used in docs/screenshots: admin@example.com / adledger-demo-123

# --- Email (optional) -------------------------------------------------------
# Used for team invitations and email alerts when no email channel is set up in
# Settings → Notifications. Example: smtps://user:pass@smtp.example.com:465
# SMTP_URL=
# SMTP_FROM=AdLedger <alerts@example.com>

# --- HTTPS (docker compose --profile https) ---------------------------------
# DOMAIN=adledger.yourcompany.com

# --- Connectors ---------------------------------------------------------------
# mock = every connector returns realistic demo data (tests, demos, CI). Empty = live.
CONNECTOR_MODE=
# Hours between ad-spend syncs.
# SYNC_INTERVAL_HOURS=6
# Stripe webhook secret fallback (normally set in Settings → Connections).
# STRIPE_WEBHOOK_SECRET=

# --- One-click connect (optional) ----------------------------------------------
# Lets users click "Connect with Meta / Google / TikTok / LinkedIn" instead of pasting tokens.
# Register an OAuth app per platform with the redirect URI
#   <PUBLIC_URL>/api/v1/oauth/<meta|google_ads|tiktok_ads|linkedin_ads>/callback
# See docs/CONNECTORS.md → "Enable one-click connect". Leave empty to keep the manual forms.
# META_APP_ID=
# META_APP_SECRET=
# Business-type Meta apps (Facebook Login for Business): the login configuration ID with ads_read.
# META_LOGIN_CONFIG_ID=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# --- AI (optional; also configurable in Settings → AI model) ------------------
# Format: provider/model. Providers: ollama, lmstudio, openai, anthropic, google, openrouter, deepseek.
# LLM_MODEL=ollama/llama3.1
# LLM_API_BASE=http://host.docker.internal:11434/v1
# LLM_API_KEY=

# --- Advanced -----------------------------------------------------------------
# Outbound URLs typed into the dashboard (webhook/Slack/Discord/Teams URLs, SMTP host, store
# URLs, AI base URLs) may not point at private, loopback, link-local or cloud-metadata addresses.
# AI base URLs may still use localhost / host.docker.internal (local Ollama, LM Studio).
# Set to true to allow private addresses too (e.g. an n8n or Ollama server elsewhere on your LAN).
# ALLOW_PRIVATE_URLS=false
# Force Secure cookies on/off (auto-detected from X-Forwarded-Proto by default).
# COOKIE_SECURE=true
# Disable background jobs (e.g. when running several app replicas with an external scheduler).
# DISABLE_SCHEDULER=true
# Do not offer the first-run product tour automatically (it can still be replayed from Settings).
# DISABLE_TOUR=true

# --- Security (optional) --------------------------------------------------------
# Your contact for vulnerability reports about this install, listed first in
# /.well-known/security.txt (an email address or https:// URL). The AdLedger project's own
# reporting form is always listed too.
# SECURITY_CONTACT=security@yourcompany.com
# Break-glass for an owner locked out of two-factor sign-in (lost phone and recovery codes):
# set to the owner's email and restart. 2FA is turned off for that account (audited, with a
# security alert). Sign in, set 2FA up again, then remove this line and restart.
# ADLEDGER_BREAK_GLASS=owner@yourcompany.com
